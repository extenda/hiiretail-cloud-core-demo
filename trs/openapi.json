{
  "openapi": "3.0.0",
  "paths": {
    "/modules/{moduleId}/translations/{langTag}": {
      "get": {
        "description": "Merges the `default` and `managed` layers, the managed value winning per key. Returns the keys published for this language tag alone: an untranslated key is absent, never null, and the response never falls back to `en-US`. Consumers fetch `en-US` alongside their target tag and fall back per missing key. Tenant overrides are not included. Anonymous and cacheable. Serves compiled ICU strings by default (`format=icu`); pass `format=raw` for the stored entry objects. Unknown query parameters are rejected.",
        "operationId": "getBaseTranslations",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          },
          {
            "name": "langTag",
            "required": true,
            "in": "path",
            "description": "Full RFC 5646 language tag.",
            "schema": {
              "example": "en-US",
              "type": "string"
            }
          },
          {
            "name": "format",
            "required": false,
            "in": "query",
            "description": "Representation to serve. `icu` compiles each value to an ICU message string; `raw` returns the stored entry objects with their declarations.",
            "schema": {
              "$ref": "#/components/schemas/ReadFormat"
            }
          },
          {
            "name": "if-none-match",
            "required": false,
            "in": "header",
            "description": "A previously returned ETag, to revalidate instead of refetching.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-modified-since",
            "required": false,
            "in": "header",
            "description": "A previously returned Last-Modified date, to revalidate instead of refetching. Ignored when If-None-Match is present.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/IcuTranslationFileDto"
                    },
                    {
                      "$ref": "#/components/schemas/RawTranslationFileDto"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "format",
                    "mapping": {
                      "icu": "#/components/schemas/IcuTranslationFileDto",
                      "raw": "#/components/schemas/RawTranslationFileDto"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": ""
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "summary": "Get the base translation file (default + managed)",
        "tags": [
          "ReadTranslations"
        ]
      }
    },
    "/modules/{moduleId}/language-tags": {
      "get": {
        "description": "The language tags a base read resolves: the `default` and `managed` layers. Tenant languages are not listed. A module with nothing published answers 404, not an empty list. Anonymous and cacheable.",
        "operationId": "getLanguageTags",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          },
          {
            "name": "if-none-match",
            "required": false,
            "in": "header",
            "description": "A previously returned ETag, to revalidate instead of refetching.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-modified-since",
            "required": false,
            "in": "header",
            "description": "A previously returned Last-Modified date, to revalidate instead of refetching. Ignored when If-None-Match is present.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LanguageTagsDto"
                }
              }
            }
          },
          "304": {
            "description": ""
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "summary": "List the language tags a module has published",
        "tags": [
          "ReadTranslations"
        ]
      }
    },
    "/tenants/{tenantId}/modules/{moduleId}/translations/{langTag}": {
      "get": {
        "description": "Merges the `default`, `managed` and `tenant` layers in that order, so a tenant override wins over the managed copy and the declarations authored in `default` survive. A tenant with nothing published reads the base file rather than a 404. Anonymous and cacheable. Serves compiled ICU strings by default (`format=icu`); pass `format=raw` for the stored entry objects. Unknown query parameters are rejected.",
        "operationId": "getTenantTranslations",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          },
          {
            "name": "langTag",
            "required": true,
            "in": "path",
            "description": "Full RFC 5646 language tag.",
            "schema": {
              "example": "en-US",
              "type": "string"
            }
          },
          {
            "name": "tenantId",
            "required": true,
            "in": "path",
            "description": "The tenant whose overrides are merged into the response.",
            "schema": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
              "example": "exampleTenant1234567",
              "type": "string"
            }
          },
          {
            "name": "format",
            "required": false,
            "in": "query",
            "description": "Representation to serve. `icu` compiles each value to an ICU message string; `raw` returns the stored entry objects with their declarations.",
            "schema": {
              "$ref": "#/components/schemas/ReadFormat"
            }
          },
          {
            "name": "if-none-match",
            "required": false,
            "in": "header",
            "description": "A previously returned ETag, to revalidate instead of refetching.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "if-modified-since",
            "required": false,
            "in": "header",
            "description": "A previously returned Last-Modified date, to revalidate instead of refetching. Ignored when If-None-Match is present.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/IcuTranslationFileDto"
                    },
                    {
                      "$ref": "#/components/schemas/RawTranslationFileDto"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "format",
                    "mapping": {
                      "icu": "#/components/schemas/IcuTranslationFileDto",
                      "raw": "#/components/schemas/RawTranslationFileDto"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": ""
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "summary": "Get the tenant-resolved translation file (default + managed + tenant)",
        "tags": [
          "ReadTranslations"
        ]
      }
    },
    "/modules/{moduleId}/translations/{langTag}/layers/{layer}": {
      "put": {
        "description": "Answers 201 when the file did not exist yet and 200 when it replaced one. The `default` layer is the module English file: it only accepts the `en-US` language tag and declares the keys the other layers may translate. A `managed` or `tenant` file may only translate keys the module already declared in its English `default` file, and carries the translated value alone — the description and the parameters stay as the `default` layer declared them. A `tenant` publish writes for the tenant named by the caller token, never by the request, and may translate `en-US` as well.",
        "operationId": "publishLayerFile",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          },
          {
            "name": "langTag",
            "required": true,
            "in": "path",
            "description": "Full RFC 5646 language tag.",
            "schema": {
              "example": "en-US",
              "type": "string"
            }
          },
          {
            "name": "layer",
            "required": true,
            "in": "path",
            "description": "The layer being published.",
            "schema": {
              "$ref": "#/components/schemas/PublishableLayer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishTranslationFileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          },
          "201": {
            "description": ""
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Publish (create or replace) a layer file",
        "tags": [
          "PublishTranslations"
        ],
        "x-permissions": [
          "trs.translation.publish"
        ]
      }
    },
    "/modules/{moduleId}/coverage": {
      "get": {
        "description": "Per language tag the module has published: how many keys its English `default` file declares, how many this tag has a value for and how many it does not. Counts only — the per key rows are a separate call, so the landing view stays cheap. Language tags come from the `default` and `managed` layers, never from a tenant's overrides. A module with no English `default` file answers 404: that file is the key set, so there is nothing to measure against.",
        "operationId": "getModuleCoverage",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleCoverageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get translation coverage counts per language tag",
        "tags": [
          "Coverage"
        ],
        "x-permissions": [
          "trs.stats.read"
        ]
      }
    },
    "/modules/{moduleId}/coverage/{langTag}": {
      "get": {
        "description": "A row per key: whether this tag has a value for it, whether the `default` layer still declares it, which parameters the translation leaves unreferenced, which plural forms this tag still owes, whether the English copy changed after the value was published, and which layer supplied it. A language tag nothing is published for is still a full report with every key missing, rather than a 404 — the rows are derived from the key set, not from this tag's file. Who last edited a key comes from the audit log, not from here.",
        "operationId": "getLanguageTagCoverage",
        "parameters": [
          {
            "name": "moduleId",
            "required": true,
            "in": "path",
            "description": "The module scope.",
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,63}$",
              "example": "hiicheckout",
              "type": "string"
            }
          },
          {
            "name": "langTag",
            "required": true,
            "in": "path",
            "description": "Full RFC 5646 language tag.",
            "schema": {
              "example": "en-US",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LanguageTagKeyCoverageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestDto"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get the per key translation status of one language tag",
        "tags": [
          "Coverage"
        ],
        "x-permissions": [
          "trs.stats.read"
        ]
      }
    }
  },
  "info": {
    "title": "Translation Service",
    "description": "Translation Service docs <br><br> <a href=\"/schemas/v1/openapi.json\">OpenAPI Document (json)</a>",
    "version": "1.0",
    "contact": {},
    "license": {
      "name": "UNLICENSED",
      "url": "UNLICENSED"
    }
  },
  "tags": [],
  "servers": [
    {
      "url": "https://translation.retailsvc.com/api/v1"
    },
    {
      "url": "https://translation.retailsvc-test.com/api/v1"
    },
    {
      "url": "https://translation.retailsvc.dev/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme."
      }
    },
    "schemas": {
      "BadRequestDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              400
            ]
          },
          "message": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "enum": [
              "Bad Request"
            ]
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "InternalServerErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              500
            ]
          },
          "message": {
            "type": "string",
            "enum": [
              "Internal Server Error"
            ]
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "IcuTranslationFileDto": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "description": "The module scope.",
            "example": "hiicheckout"
          },
          "langTag": {
            "type": "string",
            "description": "Full RFC 5646 language tag.",
            "example": "en-US"
          },
          "layer": {
            "type": "string",
            "enum": [
              "resolved"
            ],
            "description": "Resolved from the default and managed layers, plus the tenant layer on a tenant read."
          },
          "format": {
            "type": "string",
            "enum": [
              "icu"
            ],
            "description": "Plain ICU message strings compiled from the stored entries. The default when format is omitted."
          },
          "entries": {
            "type": "object",
            "description": "Each key maps to a compiled ICU message string. `description`, `parameters` and `plural` are dropped.",
            "example": {
              "cart.count": "{count, plural, one {{count} item} other {{count} items}}"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "module",
          "langTag",
          "layer",
          "format",
          "entries"
        ]
      },
      "TranslationPluralDto": {
        "type": "object",
        "properties": {
          "parameter": {
            "type": "string",
            "description": "The counting parameter. Owned by the default layer — the service copies it into every other layer at publish.",
            "example": "count"
          },
          "forms": {
            "type": "object",
            "description": "Copy for each plural category required by the language tag.",
            "example": {
              "one": "{count} item",
              "other": "{count} items"
            },
            "minProperties": 1,
            "properties": {
              "zero": {
                "type": "string"
              },
              "one": {
                "type": "string"
              },
              "two": {
                "type": "string"
              },
              "few": {
                "type": "string"
              },
              "many": {
                "type": "string"
              },
              "other": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "forms"
        ]
      },
      "TranslationEntryDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "The translated string. May contain {name} parameter placeholders.",
            "example": "Pay {amount}"
          },
          "description": {
            "type": "string",
            "description": "Human readable intent of the key. Owned by the default layer.",
            "example": "Label on the primary pay button."
          },
          "parameters": {
            "description": "Named parameters referenced by the placeholders in value. Owned by the default layer.",
            "example": [
              "amount"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plural": {
            "description": "Structured plural copy. `parameter` is owned by the default layer; other layers supply `forms` alone.",
            "allOf": [
              {
                "$ref": "#/components/schemas/TranslationPluralDto"
              }
            ]
          }
        },
        "required": [
          "value"
        ]
      },
      "RawTranslationFileDto": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "description": "The module scope.",
            "example": "hiicheckout"
          },
          "langTag": {
            "type": "string",
            "description": "Full RFC 5646 language tag.",
            "example": "en-US"
          },
          "layer": {
            "type": "string",
            "enum": [
              "resolved"
            ],
            "description": "Resolved from the default and managed layers, plus the tenant layer on a tenant read."
          },
          "format": {
            "type": "string",
            "enum": [
              "raw"
            ],
            "description": "The stored entry objects with their declarations — the editor and tooling contract."
          },
          "entries": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TranslationEntryDto"
            }
          }
        },
        "required": [
          "module",
          "langTag",
          "layer",
          "format",
          "entries"
        ]
      },
      "ReadFormat": {
        "type": "string",
        "enum": [
          "icu",
          "raw"
        ]
      },
      "NotFoundDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "enum": [
              404
            ]
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "enum": [
              "Not Found"
            ]
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "LanguageTagsDto": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "description": "The module scope.",
            "example": "hiicheckout"
          },
          "languageTags": {
            "description": "The published language tags of this module, sorted. Tenant languages are not listed.",
            "example": [
              "en-US",
              "sv-SE"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "moduleId",
          "languageTags"
        ]
      },
      "PublishableLayer": {
        "type": "string",
        "enum": [
          "default",
          "managed",
          "tenant"
        ]
      },
      "PublishTranslationFileDto": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/components/schemas/TranslationEntryDto"
            }
          }
        },
        "required": [
          "entries"
        ]
      },
      "LanguageTagCoverageDto": {
        "type": "object",
        "properties": {
          "langTag": {
            "type": "string",
            "description": "Full RFC 5646 language tag.",
            "example": "en-US"
          },
          "totalKeys": {
            "type": "integer",
            "minimum": 0,
            "description": "Keys the module's English default file declares.",
            "example": 42
          },
          "translatedKeys": {
            "type": "integer",
            "minimum": 0,
            "description": "Declared keys this language tag has a value for.",
            "example": 37
          },
          "missingKeys": {
            "type": "integer",
            "minimum": 0,
            "description": "Declared keys this language tag has no value for.",
            "example": 5
          }
        },
        "required": [
          "langTag",
          "totalKeys",
          "translatedKeys",
          "missingKeys"
        ]
      },
      "ModuleCoverageDto": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "description": "The module scope.",
            "example": "hiicheckout"
          },
          "languageTags": {
            "description": "One entry per published language tag, sorted. Always carries at least `en-US`, which is the English default file this coverage is measured against.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageTagCoverageDto"
            }
          }
        },
        "required": [
          "moduleId",
          "languageTags"
        ]
      },
      "PluralCategory": {
        "type": "string",
        "enum": [
          "zero",
          "one",
          "two",
          "few",
          "many",
          "other"
        ],
        "description": "Plural categories this language tag requires that the translation supplies no form for. A translation may be published with a value and no plural at all, and a read then serves that flat value with no plural selection — the key looks translated while no count renders correctly. Empty for a key the default layer declares no plural for, and for an untranslated key."
      },
      "BaseLayer": {
        "type": "string",
        "enum": [
          "default",
          "managed"
        ],
        "description": "Which layer supplied the value, or `null` when none did. The tenant layer is never reported: coverage is the Extenda view of what the managed layer covers."
      },
      "KeyCoverageDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The translation key.",
            "example": "checkout.button.pay"
          },
          "translated": {
            "type": "boolean",
            "description": "This language tag has a value for the key."
          },
          "orphan": {
            "type": "boolean",
            "description": "The default layer no longer declares this key. A read still serves it, by design — this is where it becomes visible so it can be cleaned up."
          },
          "unusedParameters": {
            "description": "Parameters the key declares that the translation never references — a placeholder it dropped. Read over the whole entry, plural forms included, since that is where a plural translation carries its counting parameter. Empty for an untranslated key, which has no copy to check.",
            "example": [
              "amount"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingPluralForms": {
            "type": "array",
            "description": "Plural categories this language tag requires that the translation supplies no form for. A translation may be published with a value and no plural at all, and a read then serves that flat value with no plural selection — the key looks translated while no count renders correctly. Empty for a key the default layer declares no plural for, and for an untranslated key.",
            "example": [
              "few",
              "many"
            ],
            "items": {
              "$ref": "#/components/schemas/PluralCategory"
            }
          },
          "stale": {
            "type": "boolean",
            "nullable": true,
            "description": "The English copy changed after this value was published — the plural forms of the key among it, not only the flat value. `null` when it cannot be told: nothing is translated here, the key is an orphan with no English source left to compare, or the value predates the source fingerprint the publish path now stamps. Each of those resolves on that entry’s next publish."
          },
          "layer": {
            "nullable": true,
            "description": "Which layer supplied the value, or `null` when none did. The tenant layer is never reported: coverage is the Extenda view of what the managed layer covers.",
            "allOf": [
              {
                "$ref": "#/components/schemas/BaseLayer"
              }
            ]
          }
        },
        "required": [
          "key",
          "translated",
          "orphan",
          "unusedParameters",
          "missingPluralForms",
          "stale",
          "layer"
        ]
      },
      "LanguageTagKeyCoverageDto": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$",
            "description": "The module scope.",
            "example": "hiicheckout"
          },
          "langTag": {
            "type": "string",
            "description": "Full RFC 5646 language tag.",
            "example": "en-US"
          },
          "keys": {
            "description": "One row per key, sorted by key: every key the default layer declares, plus any orphan this language tag still holds.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyCoverageDto"
            }
          }
        },
        "required": [
          "moduleId",
          "langTag",
          "keys"
        ]
      }
    }
  }
}
